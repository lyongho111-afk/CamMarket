+        for(var pair:pairs){
+            var owner=members.findByAccountKey("staff:"+pair[0]).orElse(null);
+            if(owner==null||!owner.isOwner()||db.queryForObject("SELECT COUNT(*) FROM shops WHERE owner_member_id=?",Integer.class,owner.getId())!=1)continue;
